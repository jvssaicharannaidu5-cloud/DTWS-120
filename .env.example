# ==============================================================================
# DIGITAL TWIN WELL-SURFACE OPTIMIZATION PLATFORM (DTW-SOP)
# Backend Email Service Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# DO NOT COMMIT REAL PASSWORDS, TOKENS, OR API KEYS TO VERSION CONTROL.
# Copy this file to .env and configure your local or deployment credentials.
# ==============================================================================

# Backend Server Port
PORT=3001

# Primary Recipient Email for Field Alerts & Digest
NOTIFICATION_EMAIL=jvssaicharannaidu5@gmail.com

# From Address header
EMAIL_FROM_ADDRESS="DTW-SOP Baghewala Operations" <alerts@baghewala-digitaltwin.internal>

# Email Delivery Mode:
# 'simulation' : High-fidelity simulated delivery with outbox logging and HTML preview (Default safe mode)
# 'smtp'       : Transmit via authenticated SMTP (Gmail App Password, Sendgrid SMTP, AWS SES, etc.)
# 'resend'     : Transmit via Resend / SendGrid REST API
EMAIL_SERVICE_MODE=simulation

# SMTP Configuration (Active when EMAIL_SERVICE_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Provider API Key (Active when EMAIL_SERVICE_MODE=resend or sendgrid)
EMAIL_PROVIDER_API_KEY=

# Base URL of Digital Twin Dashboard (embedded in email CTA buttons)
DASHBOARD_URL=http://localhost:3000

# Security & Suppression Limits
RATE_LIMIT_MAX_PER_HOUR=60
ALERT_COOLDOWN_MINUTES=15

# Millis AI Voice Agent Configuration (Arise Voice Assistant)
MILLIS_AGENT_ID=-P2gcPI5t_7Djy8toIcp
MILLIS_PUBLIC_KEY=
